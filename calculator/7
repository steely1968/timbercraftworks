<body>

<header>
<h1>Timber Craft Works</h1>
</header>

<main>

<div class="calculator">

<h2>Floor Joist Spacing Calculator</h2>

<div class="field">
<label for="floorLength">Overall Floor Length (mm)</label>
<input type="number" id="floorLength" min="1" placeholder="Enter overall floor length">
</div>

<div class="field">
<label for="floorWidth">Overall Floor Width (mm)</label>
<input type="number" id="floorWidth" min="1" placeholder="Enter overall floor width">
</div>

<div class="field">
<label for="joistThickness">Timber Thickness (mm)</label>
<input type="number" id="joistThickness" min="1" placeholder="Enter timber thickness">
</div>

<div class="field">
<label for="numberOfJoists">Number of Floor Joists (including end joists)</label>
<input type="number" id="numberOfJoists" min="2" step="1" placeholder="Enter number of floor joists">
</div>

<button onclick="calculateJoists()">Calculate Floor Joist Positions</button>

<div class="results" id="results">

<h2 style="margin-top:25px;">Calculation Results</h2>

<div class="summary" id="summary"></div>

<h3>Floor Joist Position Table</h3>

<div class="table-wrapper">
<table>
<thead>
<tr>
<th>Joist</th>
<th>Start (mm)</th>
<th>Finish (mm)</th>
<th>Clear Gap (mm)</th>
</tr>
</thead>
<tbody id="joistTable"></tbody>
</table>
</div>

<div class="diagram-section">

<h3>Scaled Floor Joist Layout</h3>

<p>Overhead view of the complete timber floor frame.</p>

<div class="diagram-container">
<svg id="joistDiagram"
xmlns="http://www.w3.org/2000/svg"
role="img"
aria-label="Scaled overhead timber floor joist diagram">
</svg>
</div>

<div class="diagram-key">
<div class="key-item">
<span class="key-colour"></span>
Timber
</div>
</div>

<div class="diagram-note">
All timber members are drawn using the same thickness measurement.
The two long side rails run continuously along the floor frame.
The floor joists connect the inside faces of the side rails.
The diagram scales automatically to the entered measurements.
</div>

</div>

<!-- CUTTING LIST -->

<div class="cutting-list">

<h3>Cutting List</h3>

<p>Timber required to build the floor frame from the measurements entered above.</p>

<div class="table-wrapper">

<table>
<thead>
<tr>
<th>Qty</th>
<th>Timber</th>
<th>Cut Length</th>
<th>Thickness</th>
</tr>
</thead>

<tbody id="cuttingListTable">
</tbody>

</table>

</div>

<div class="cutting-note">
Cut lengths are calculated automatically from the entered floor dimensions.
The two side rails are the full floor length.
The floor joists fit between the two side rails.
</div>

</div>

</div>
</div>

</main>

<footer>
Timber Craft Works
</footer>

<script>

function calculateJoists() {

const length = Number(document.getElementById("floorLength").value);
const width = Number(document.getElementById("floorWidth").value);
const thickness = Number(document.getElementById("joistThickness").value);
const count = Number(document.getElementById("numberOfJoists").value);

if (
!Number.isFinite(length) ||
!Number.isFinite(width) ||
!Number.isFinite(thickness) ||
!Number.isInteger(count) ||
length <= 0 ||
width <= 0 ||
thickness <= 0 ||
count < 2
) {
alert("Please enter valid measurements and at least two floor joists.");
return;
}

if (width <= thickness * 2 || length < thickness * count) {
alert("The floor dimensions are too small for the timber thickness and number of floor joists.");
return;
}

// Floor joists fit between the two continuous side rails.

const crossJoistLength = width - (thickness * 2);

// Floor joists include both end joists.

const clearGap = (length - thickness * count) / (count - 1);

const positions = [];

let currentPosition = 0;

for (let i = 0; i < count; i++) {

const start = currentPosition;
const finish = start + thickness;

positions.push({
number: i + 1,
start: start,
finish: finish,
gap: i === count - 1 ? 0 : clearGap
});

currentPosition = finish + clearGap;
}

document.getElementById("summary").innerHTML = `
<strong>Overall floor length:</strong> ${length.toFixed(2)} mm<br>
<strong>Overall floor width:</strong> ${width.toFixed(2)} mm<br>
<strong>Timber thickness:</strong> ${thickness.toFixed(2)} mm<br>
<strong>Number of floor joists:</strong> ${count}<br>
<strong>Side rail length:</strong> ${length.toFixed(2)} mm<br>
<strong>Floor joist length:</strong> ${crossJoistLength.toFixed(2)} mm<br>
<strong>Clear gap between floor joists:</strong> ${clearGap.toFixed(2)} mm
`;

const table = document.getElementById("joistTable");
table.innerHTML = "";

positions.forEach(joist => {

const row = document.createElement("tr");

row.innerHTML = `
<td>${joist.number}</td>
<td>${joist.start.toFixed(2)}</td>
<td>${joist.finish.toFixed(2)}</td>
<td>${joist.gap.toFixed(2)}</td>
`;

table.appendChild(row);
});


// CUTTING LIST

const cuttingListTable = document.getElementById("cuttingListTable");

cuttingListTable.innerHTML = `

<tr>
<td>2</td>
<td>Side Rails</td>
<td>${length.toFixed(2)} mm</td>
<td>${thickness.toFixed(2)} mm</td>
</tr>

<tr>
<td>${count}</td>
<td>Floor Joists</td>
<td>${crossJoistLength.toFixed(2)} mm</td>
<td>${thickness.toFixed(2)} mm</td>
</tr>

`;

drawJoistDiagram(length, width, thickness, positions);

document.getElementById("results").style.display = "block";
}

function drawJoistDiagram(length, width, thickness, positions) {

const svg = document.getElementById("joistDiagram");

const svgWidth = 700;
const svgHeight = 480;

// Drawing margins.

const left = 105;
const right = 35;
const top = 90;
const bottom = 90;

const availableWidth = svgWidth - left - right;
const availableHeight = svgHeight - top - bottom;

// One uniform scale for both dimensions.

const scale = Math.min(
availableWidth / length,
availableHeight / width
);

const drawingLength = length * scale;
const drawingWidth = width * scale;

// ALL timber uses this exact same thickness.

const timber = thickness * scale;

const x = left + (availableWidth - drawingLength) / 2;
const y = top + (availableHeight - drawingWidth) / 2;

const colour = "#bd8950";
const outline = "#80572d";

let drawing = "";

// Frame background.

drawing += `
<rect
x="${x}"
y="${y}"
width="${drawingLength}"
height="${drawingWidth}"
fill="#fafafa"
stroke="#777"
stroke-width="1"
/>
`;

// LEFT LONG SIDE RAIL.
// Full floor length.
// Same thickness as every floor joist.

drawing += `
<rect
x="${x}"
y="${y}"
width="${drawingLength}"
height="${timber}"
fill="${colour}"
stroke="${outline}"
stroke-width="1"
/>
`;

// RIGHT LONG SIDE RAIL.
// Full floor length.
// Exactly the same thickness.

drawing += `
<rect
x="${x}"
y="${y + drawingWidth - timber}"
width="${drawingLength}"
height="${timber}"
fill="${colour}"
stroke="${outline}"
stroke-width="1"
/>
`;

// INTERNAL FLOOR JOISTS.
// Run BETWEEN the two long side rails.
// Same thickness as the side rails.

positions.forEach((joist, index) => {

const joistX = x + (joist.start * scale);

drawing += `
<rect
x="${joistX}"
y="${y + timber}"
width="${timber}"
height="${drawingWidth - (timber * 2)}"
fill="${colour}"
stroke="${outline}"
stroke-width="1"
/>
`;

if (timber > 16) {

drawing += `
<text
x="${joistX + timber / 2}"
y="${y + drawingWidth / 2}"
text-anchor="middle"
dominant-baseline="middle"
font-size="11"
fill="#382514"
>${index + 1}</text>
`;
}

});

// OVERALL FLOOR LENGTH DIMENSION.

drawing += `
<line
x1="${x}"
y1="${y - 35}"
x2="${x + drawingLength}"
y2="${y - 35}"
stroke="#222"
stroke-width="1.5"
/>

<line
x1="${x}"
y1="${y - 42}"
x2="${x}"
y2="${y - 28}"
stroke="#222"
stroke-width="1.5"
/>

<line
x1="${x + drawingLength}"
y1="${y - 42}"
x2="${x + drawingLength}"
y2="${y - 28}"
stroke="#222"
stroke-width="1.5"
/>

<text
x="${x + drawingLength / 2}"
y="${y - 48}"
text-anchor="middle"
font-size="14"
font-weight="bold"
fill="#222"
>${length} mm</text>
`;

// OVERALL FLOOR WIDTH DIMENSION.

drawing += `
<line
x1="${x - 35}"
y1="${y}"
x2="${x - 35}"
y2="${y + drawingWidth}"
stroke="#222"
stroke-width="1.5"
/>

<line
x1="${x - 42}"
y1="${y}"
x2="${x - 28}"
y2="${y}"
stroke="#222"
stroke-width="1.5"
/>

<line
x1="${x - 42}"
y1="${y + drawingWidth}"
x2="${x - 28}"
y2="${y + drawingWidth}"
stroke="#222"
stroke-width="1.5"
/>

<text
x="${x - 48}"
y="${y + drawingWidth / 2}"
text-anchor="middle"
dominant-baseline="middle"
font-size="13"
font-weight="bold"
fill="#222"
transform="rotate(-90 ${x - 48} ${y + drawingWidth / 2})"
>${width} mm</text>
`;

// Timber thickness label.

drawing += `
<text
x="${svgWidth / 2}"
y="${svgHeight - 24}"
text-anchor="middle"
font-size="12"
fill="#444"
>All timber: ${thickness} mm thick</text>
`;

svg.setAttribute("viewBox", `0 0 ${svgWidth} ${svgHeight}`);

svg.setAttribute("preserveAspectRatio", "xMidYMid meet");

svg.innerHTML = drawing;
}

</script>

</body>
</html>
