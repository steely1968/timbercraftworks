width: 100%;
padding: 15px;
background: #111;
color: white;
border: none;
border-radius: 5px;
font-size: 17px;
font-weight: bold;
cursor: pointer;
}

button:hover {
background: #333;
}

.results {
display: none;
margin-top: 30px;
}

.summary {
background: #f1f1f1;
