row.innerHTML = `
<td>${joist.number}</td>
<td>${joist.start.toFixed(2)}</td>
<td>${joist.finish.toFixed(2)}</td>
<td>${joist.gap.toFixed(2)}</td>
`;

table.appendChild(row);
});


// CUTTING LIST

const cuttingListTable = document.getElementById("cuttingListTable");

cuttingListTable.innerHTML = `

<tr>
<td>2</td>
<td>Side Rails</td>
<td>${length.toFixed(2)} mm</td>
<td>${thickness.toFixed(2)} mm</td>
</tr>

<tr>
<td>${count}</td>
<td>Wall Studs</td>
<td>${crossJoistLength.toFixed(2)} mm</td>
<td>${thickness.toFixed(2)} mm</td>
</tr>

`;

drawJoistDiagram(length, width, thickness, positions);

document.getElementById("results").style.display = "block";
}

function drawJoistDiagram(length, width, thickness, positions) {

const svg = document.getElementById("joistDiagram");

const svgWidth = 700;
const svgHeight = 480;

// Drawing margins.

const left = 105;
const right = 35;
const top = 90;
const bottom = 90;

const availableWidth = svgWidth - left - right;
const availableHeight = svgHeight - top - bottom;

// One uniform scale for both dimensions.

const scale = Math.min(
availableWidth / length,
availableHeight / width
);

const drawingLength = length * scale;
const drawingWidth = width * scale;

// ALL timber uses this exact same thickness.

const timber = thickness * scale;

const x = left + (availableWidth - drawingLength) / 2;
const y = top + (availableHeight - drawingWidth) / 2;

const colour = "#bd8950";
const outline = "#80572d";

let drawing = "";

// Frame background.

drawing += `
<rect
x="${x}"
y="${y}"
width="${drawingLength}"
height="${drawingWidth}"
fill="#fafafa"
stroke="#777"
stroke-width="1"
/>
`;

// LEFT LONG SIDE RAIL.
// Full back wall length.
// Same thickness as every wall stud.

drawing += `
<rect
x="${x}"
y="${y}"
width="${drawingLength}"
height="${timber}"
fill="${colour}"
stroke="${outline}"
stroke-width="1"
/>
`;

// RIGHT LONG SIDE RAIL.
// Full back wall length.
// Exactly the same thickness.

drawing += `
<rect
x="${x}"
y="${y + drawingWidth - timber}"
width="${drawingLength}"
height="${timber}"
fill="${colour}"
stroke="${outline}"
stroke-width="1"
/>
`;

// INTERNAL WALL STUDS.
// Run BETWEEN the two long side rails.
// Same thickness as the side rails.

positions.forEach((joist, index) => {

const joistX = x + (joist.start * scale);

drawing += `
<rect
x="${joistX}"
y="${y + timber}"
width="${timber}"
height="${drawingWidth - (timber * 2)}"
fill="${colour}"
stroke="${outline}"
stroke-width="1"
/>
`;

if (timber > 16) {

drawing += `
<text
x="${joistX + timber / 2}"
y="${y + drawingWidth / 2}"
text-anchor="middle"
dominant-baseline="middle"
font-size="11"
fill="#382514"
>${index + 1}</text>
`;
}

});

// OVERALL BACK WALL LENGTH DIMENSION.

drawing += `
<line
x1="${x}"
y1="${y - 35}"
x2="${x + drawingLength}"
y2="${y - 35}"
stroke="#222"
stroke-width="1.5"
/>

<line
x1="${x}"
y1="${y - 42}"
x2="${x}"
y2="${y - 28}"
stroke="#222"
stroke-width="1.5"
/>

<line
x1="${x + drawingLength}"
y1="${y - 42}"
x2="${x + drawingLength}"
y2="${y - 28}"
stroke="#222"
stroke-width="1.5"
/>

<text
x="${x + drawingLength / 2}"
y="${y - 48}"
text-anchor="middle"
font-size="14"
font-weight="bold"
fill="#222"
>${length} mm</text>
`;

// OVERALL BACK WALL HEIGHT DIMENSION.

drawing += `
<line
x1="${x - 35}"
y1="${y}"
x2="${x - 35}"
y2="${y + drawingWidth}"
stroke="#222"
stroke-width="1.5"
/>

<line
x1="${x - 42}"
y1="${y}"
x2="${x - 28}"
y2="${y}"
stroke="#222"
stroke-width="1.5"
/>

<line
x1="${x - 42}"
y1="${y + drawingWidth}"
x2="${x - 28}"
y2="${y + drawingWidth}"
stroke="#222"
stroke-width="1.5"
/>

<text
x="${x - 48}"
y="${y + drawingWidth / 2}"
text-anchor="middle"
dominant-baseline="middle"
font-size="13"
font-weight="bold"
fill="#222"
transform="rotate(-90 ${x - 48} ${y + drawingWidth / 2})"
>${width} mm</text>
`;

// Timber thickness label.

drawing += `
<text
x="${svgWidth / 2}"
y="${svgHeight - 24}"
text-anchor="middle"
font-size="12"
fill="#444"
>All timber: ${thickness} mm thick</text>
`;

svg.setAttribute("viewBox", `0 0 ${svgWidth} ${svgHeight}`);

svg.setAttribute("preserveAspectRatio", "xMidYMid meet");

svg.innerHTML = drawing;
}

</script>

</body>
</html>
