<script>

// SIDE WALL CALCULATOR - UNCHANGED

function calculateWall() {

const length = Number(document.getElementById("wallLength").value);
const low = Number(document.getElementById("lowHeight").value);
const high = Number(document.getElementById("highHeight").value);
const thickness = Number(document.getElementById("timberThickness").value);
const count = Number(document.getElementById("numberOfStuds").value);

if (!Number.isFinite(length) || !Number.isFinite(low) ||
!Number.isFinite(high) || !Number.isFinite(thickness) ||
!Number.isInteger(count) || length <= 0 || low <= 0 ||
high <= 0 || thickness <= 0 || count < 2) {
alert("Please enter valid measurements and at least two wall studs.");
return;
}

if (low <= thickness * 2 || high <= thickness * 2 ||
length < thickness * count) {
alert("The wall dimensions are too small for the timber thickness and number of studs.");
return;
}

const rise = high - low;
const angleRadians = Math.atan(rise / length);
const angleDegrees = angleRadians * 180 / Math.PI;
const slopeLength = Math.sqrt(length * length + rise * rise);
const clearGap = (length - thickness * count) / (count - 1);
const topRailVerticalDepth = thickness / Math.cos(angleRadians);

const positions = [];

for (let i = 0; i < count; i++) {
const start = i * (thickness + clearGap);
const centre = start + thickness / 2;
const wallHeightAtCentre = low + rise * centre / length;
const studLength = wallHeightAtCentre - thickness - topRailVerticalDepth;

if (studLength <= 0) {
alert("The wall is too short for the selected timber thickness.");
return;
}

positions.push({
number:i+1,
start:start,
centre:centre,
length:studLength,
gap:i === count-1 ? 0 : clearGap
});
}

document.getElementById("summary").innerHTML = `
<strong>Overall side wall length:</strong> ${length.toFixed(2)} mm<br>
<strong>Low end wall height:</strong> ${low.toFixed(2)} mm<br>
<strong>High end wall height:</strong> ${high.toFixed(2)} mm<br>
<strong>Height difference:</strong> ${rise.toFixed(2)} mm<br>
<strong>Timber thickness:</strong> ${thickness.toFixed(2)} mm<br>
<strong>Number of wall studs per wall:</strong> ${count}<br>
<strong>Clear gap between studs:</strong> ${clearGap.toFixed(2)} mm<br>
<strong>Sloping top rail length:</strong> ${slopeLength.toFixed(2)} mm<br>
<strong>Pent roof angle:</strong> ${Math.abs(angleDegrees).toFixed(2)} degrees
`;

const table = document.getElementById("studTable");
table.innerHTML = "";

positions.forEach(stud => {
const row = document.createElement("tr");
row.innerHTML = `
<td>${stud.number}</td>
<td>${stud.start.toFixed(2)}</td>
<td>${stud.length.toFixed(2)}</td>
<td>${stud.gap.toFixed(2)}</td>`;
table.appendChild(row);
});

let cuttingRows = `
<tr><td>2</td><td>Bottom Rails</td><td>${length.toFixed(2)} mm</td><td>${thickness.toFixed(2)} mm</td><td>90°</td></tr>
<tr><td>2</td><td>Sloping Top Rails</td><td>${slopeLength.toFixed(2)} mm</td><td>${thickness.toFixed(2)} mm</td><td>${Math.abs(angleDegrees).toFixed(2)}°</td></tr>
`;

positions.forEach(stud => {
cuttingRows += `
<tr><td>2</td><td>Wall Stud ${stud.number}</td><td>${stud.length.toFixed(2)} mm</td><td>${thickness.toFixed(2)} mm</td><td>${Math.abs(angleDegrees).toFixed(2)}° top</td></tr>`;
});

document.getElementById("cuttingListTable").innerHTML = cuttingRows;

drawWallDiagram(length,low,high,thickness,positions);

document.getElementById("results").style.display = "block";
}

function drawWallDiagram(length,low,high,thickness,positions) {

const svg=document.getElementById("wallDiagram");
const W=700,H=480,left=90,right=65,top=75,bottom=90;
const aw=W-left-right,ah=H-top-bottom;
const rise=high-low;
const angle=Math.atan(rise/length);
const slopeDepth=thickness/Math.cos(angle);
const scale=Math.min(aw/length,ah/Math.max(low,high));
const dw=length*scale;
const timber=thickness*scale;
const sd=slopeDepth*scale;
const x=left+(aw-dw)/2;
const baseY=top+ah;
const tl=baseY-low*scale;
const tr=baseY-high*scale;
const colour="#bd8950",outline="#80572d";
let d="";

d+=`<rect x="${x}" y="${baseY-timber}" width="${dw}" height="${timber}" fill="${colour}" stroke="${outline}"/>`;

d+=`<polygon points="${x},${tl} ${x+dw},${tr} ${x+dw},${tr+sd} ${x},${tl+sd}" fill="${colour}" stroke="${outline}"/>`;

positions.forEach((stud,i)=>{
const sx=x+stud.start*scale;
const topY=baseY-(low+rise*stud.centre/length)*scale+sd;
const bottomY=baseY-timber;
d+=`<rect x="${sx}" y="${topY}" width="${timber}" height="${bottomY-topY}" fill="${colour}" stroke="${outline}"/>`;
if(timber>16)d+=`<text x="${sx+timber/2}" y="${(topY+bottomY)/2}" text-anchor="middle" dominant-baseline="middle" font-size="11" fill="#382514">${i+1}</text>`;
});

d+=`<line x1="${x}" y1="${baseY+25}" x2="${x+dw}" y2="${baseY+25}" stroke="#222" stroke-width="1.5"/>
<text x="${x+dw/2}" y="${baseY+45}" text-anchor="middle" font-size="14" font-weight="bold">${length} mm</text>`;

d+=`<text x="${x-40}" y="${(baseY+tl)/2}" text-anchor="middle" font-size="12" transform="rotate(-90 ${x-40} ${(baseY+tl)/2})">${low} mm</text>`;
d+=`<text x="${x+dw+42}" y="${(baseY+tr)/2}" text-anchor="middle" font-size="12" transform="rotate(-90 ${x+dw+42} ${(baseY+tr)/2})">${high} mm</text>`;

d+=`<text x="${x+dw/2}" y="${Math.min(tl,tr)-18}" text-anchor="middle" font-size="13" font-weight="bold">${Math.abs(angle*180/Math.PI).toFixed(2)}° pent angle</text>`;
d+=`<text x="${W/2}" y="${H-12}" text-anchor="middle" font-size="12" fill="#444">Side wall elevation - all measurements in mm</text>`;

svg.setAttribute("viewBox",`0 0 ${W} ${H}`);
svg.setAttribute("preserveAspectRatio","xMidYMid meet");
svg.innerHTML=d;
}


// INDEPENDENT ROOF JOIST CALCULATOR
// JOISTS RUN FRONT TO BACK.
// JOISTS ARE SPACED ACROSS THE ROOF WIDTH.

function calculateRoof() {

const length=Number(document.getElementById("roofLength").value);
const width=Number(document.getElementById("roofWidth").value);
const frontHeight=Number(document.getElementById("roofFrontHeight").value);
const rearHeight=Number(document.getElementById("roofRearHeight").value);
const thickness=Number(document.getElementById("roofThickness").value);
const count=Number(document.getElementById("roofJoistCount").value);
const front=Number(document.getElementById("frontOverhang").value);
const rear=Number(document.getElementById("rearOverhang").value);

if(!Number.isFinite(length)||!Number.isFinite(width)||
!Number.isFinite(frontHeight)||!Number.isFinite(rearHeight)||
!Number.isFinite(thickness)||!Number.isFinite(front)||
!Number.isFinite(rear)||!Number.isInteger(count)||
length<=0||width<=0||frontHeight<=0||rearHeight<=0||
thickness<=0||front<0||rear<0||count<2) {
alert("Please enter valid roof measurements, roof heights, overhangs and at least two joists.");
return;
}

if(width < thickness*count) {
alert("The roof width is too small for the selected number and thickness of joists.");
return;
}

const heightDifference=rearHeight-frontHeight;
const rise=Math.abs(heightDifference);
const roofAngleRadians=Math.atan(heightDifference/length);
const roofAngleDegrees=Math.abs(roofAngleRadians*180/Math.PI);

const totalHorizontalLength=length+front+rear;
const totalHeightDifference=heightDifference/length*totalHorizontalLength;

const slopingJoistLength=Math.sqrt(
totalHorizontalLength*totalHorizontalLength+
totalHeightDifference*totalHeightDifference
);

const clearGap=(width-(thickness*count))/(count-1);

const positions=[];

for(let i=0;i<count;i++) {
const start=i*(thickness+clearGap);

positions.push({
number:i+1,
start:start,
centre:start+thickness/2,
gap:i===count-1?0:clearGap
});
}

const totalInfill=(count-1)*2;

document.getElementById("roofSummary").innerHTML=`
<strong>Horizontal roof length between walls:</strong> ${length.toFixed(2)} mm<br>
<strong>Overall roof width:</strong> ${width.toFixed(2)} mm<br>
<strong>Front wall roof height:</strong> ${frontHeight.toFixed(2)} mm<br>
<strong>Rear wall roof height:</strong> ${rearHeight.toFixed(2)} mm<br>
<strong>Roof height difference:</strong> ${rise.toFixed(2)} mm<br>
<strong>Roof pitch angle:</strong> ${roofAngleDegrees.toFixed(2)} degrees<br>
<strong>Front overhang:</strong> ${front.toFixed(2)} mm horizontal<br>
<strong>Rear overhang:</strong> ${rear.toFixed(2)} mm horizontal<br>
<strong>Total horizontal front-to-back length:</strong> ${totalHorizontalLength.toFixed(2)} mm<br>
<strong>Calculated sloping joist cut length:</strong> ${slopingJoistLength.toFixed(2)} mm<br>
<strong>Roof joist timber thickness:</strong> ${thickness.toFixed(2)} mm<br>
<strong>Number of roof joists:</strong> ${count}<br>
<strong>Clear gap between joists across width:</strong> ${clearGap.toFixed(2)} mm<br>
<strong>Front infill pieces over front wall line:</strong> ${count-1}<br>
<strong>Rear infill pieces over rear wall line:</strong> ${count-1}<br>
<strong>Total infill pieces:</strong> ${totalInfill}
`;

const table=document.getElementById("roofJoistTable");
table.innerHTML="";

positions.forEach(p=>{
const row=document.createElement("tr");
row.innerHTML=`
<td>${p.number}</td>
<td>${p.start.toFixed(2)}</td>
<td>${slopingJoistLength.toFixed(2)}</td>
<td>${p.gap.toFixed(2)}</td>`;
table.appendChild(row);
});

// ROOF CUTTING LIST

let rows=`
<tr>
<td>${count}</td>
<td>Front-to-Back Roof Joists</td>
<td>${slopingJoistLength.toFixed(2)} mm</td>
<td>${thickness.toFixed(2)} mm</td>
<td>Front to rear</td>
</tr>
<tr>
<td>${count-1}</td>
<td>Front Infill Timber</td>
<td>${clearGap.toFixed(2)} mm</td>
<td>${thickness.toFixed(2)} mm</td>
<td>Centred over front wall line</td>
</tr>
<tr>
<td>${count-1}</td>
<td>Rear Infill Timber</td>
<td>${clearGap.toFixed(2)} mm</td>
<td>${thickness.toFixed(2)} mm</td>
<td>Centred over rear wall line</td>
</tr>
`;

document.getElementById("roofCuttingTable").innerHTML=rows;

drawRoofDiagram(
length,width,thickness,front,rear,
positions,clearGap,slopingJoistLength,
roofAngleDegrees,frontHeight,rearHeight
);

document.getElementById("roofResults").style.display="block";
}


function drawRoofDiagram(
length,width,thickness,front,rear,
positions,gap,slopingLength,angleDegrees,
frontHeight,rearHeight
) {

const svg=document.getElementById("roofDiagram");

const W=760,H=570;
const left=95,right=125,top=95,bottom=115;

const totalFrontBack=length+front+rear;

const scale=Math.min(
(W-left-right)/width,
(H-top-bottom)/totalFrontBack
);

const drawingWidth=width*scale;
const drawingLength=totalFrontBack*scale;
const timber=thickness*scale;

const x=left;
const y=top;
const endX=x+drawingWidth;
const endY=y+drawingLength;

const frontWallY=y+front*scale;
const rearWallY=frontWallY+length*scale;

const colour="#bd8950";
const outline="#80572d";

let d="";

// Roof outline

d+=`<rect x="${x}" y="${y}" width="${drawingWidth}" height="${drawingLength}" fill="#fafafa" stroke="#777" stroke-width="1.5"/>`;

// Front and rear wall reference lines

d+=`<line x1="${x-12}" y1="${frontWallY}" x2="${endX+12}" y2="${frontWallY}" stroke="#222" stroke-width="2" stroke-dasharray="6 4"/>`;

d+=`<line x1="${x-12}" y1="${rearWallY}" x2="${endX+12}" y2="${rearWallY}" stroke="#222" stroke-width="2" stroke-dasharray="6 4"/>`;

// Roof joists run continuously from FRONT to BACK.

positions.forEach((p,i)=>{

const joistX=x+p.start*scale;

d+=`<rect x="${joistX}" y="${y}" width="${timber}" height="${drawingLength}" fill="${colour}" stroke="${outline}" stroke-width="1"/>`;

if(timber>17) {
d+=`<text x="${joistX+timber/2}" y="${y+drawingLength/2}" text-anchor="middle" dominant-baseline="middle" font-size="11" fill="#382514">${i+1}</text>`;
}

});

// INFILLS ARE CENTRED ON THE WALL LINES.
// They are NOT placed at the ends of the overhangs.
// Each block sits between two adjacent joists.

for(let i=0;i<positions.length-1;i++){

const blockX=x+(positions[i].start+thickness)*scale;
const blockWidth=gap*scale;

// Front infill: centre aligned with front wall line.

d+=`<rect x="${blockX}" y="${frontWallY-timber/2}" width="${blockWidth}" height="${timber}" fill="${colour}" stroke="${outline}" stroke-width="1"/>`;

// Rear infill: centre aligned with rear wall line.

d+=`<rect x="${blockX}" y="${rearWallY-timber/2}" width="${blockWidth}" height="${timber}" fill="${colour}" stroke="${outline}" stroke-width="1"/>`;

}

// Draw wall reference lines on top so their positions remain visible.

d+=`<line x1="${x-12}" y1="${frontWallY}" x2="${endX+12}" y2="${frontWallY}" stroke="#222" stroke-width="1.5" stroke-dasharray="6 4"/>`;

d+=`<line x1="${x-12}" y1="${rearWallY}" x2="${endX+12}" y2="${rearWallY}" stroke="#222" stroke-width="1.5" stroke-dasharray="6 4"/>`;

// Front and rear labels

d+=`<text x="${x+drawingWidth/2}" y="${y-17}" text-anchor="middle" font-size="13" font-weight="bold">FRONT</text>`;

d+=`<text x="${x+drawingWidth/2}" y="${endY+20}" text-anchor="middle" font-size="13" font-weight="bold">REAR</text>`;

// Wall line labels

d+=`<text x="${endX+15}" y="${frontWallY+4}" text-anchor="start" font-size="11" font-weight="bold">FRONT WALL</text>`;

d+=`<text x="${endX+15}" y="${rearWallY+4}" text-anchor="start" font-size="11" font-weight="bold">REAR WALL</text>`;

// Joist direction label

d+=`<text x="${x+drawingWidth/2}" y="${y+drawingLength/2}" text-anchor="middle" font-size="13" font-weight="bold" fill="#382514" opacity="0.8">JOISTS RUN FRONT TO BACK</text>`;

// Width dimension across the joists

const widthDimY=endY+45;

d+=`<line x1="${x}" y1="${widthDimY}" x2="${endX}" y2="${widthDimY}" stroke="#222" stroke-width="1.5"/>
<line x1="${x}" y1="${widthDimY-6}" x2="${x}" y2="${widthDimY+6}" stroke="#222"/>
<line x1="${endX}" y1="${widthDimY-6}" x2="${endX}" y2="${widthDimY+6}" stroke="#222"/>
<text x="${x+drawingWidth/2}" y="${widthDimY+18}" text-anchor="middle" font-size="12" font-weight="bold">${width.toFixed(2)} mm overall width</text>`;

// Front overhang label

d+=`<text x="${x-12}" y="${y+front*scale/2}" text-anchor="end" font-size="11">Front OH ${front} mm</text>`;

// Rear overhang label

d+=`<text x="${x-12}" y="${rearWallY+rear*scale/2}" text-anchor="end" font-size="11">Rear OH ${rear} mm</text>`;

// Overall front-to-back horizontal length

d+=`<text x="${x-42}" y="${y+drawingLength/2}" text-anchor="middle" dominant-baseline="middle" font-size="12" font-weight="bold" transform="rotate(-90 ${x-42} ${y+drawingLength/2})">${totalFrontBack.toFixed(2)} mm horizontal</text>`;

// Sloping joist length and roof angle

d+=`<text x="${W/2}" y="${H-35}" text-anchor="middle" font-size="13" font-weight="bold">Sloping joist cut length: ${slopingLength.toFixed(2)} mm</text>`;

d+=`<text x="${W/2}" y="${H-13}" text-anchor="middle" font-size="12" fill="#444">Roof pitch: ${angleDegrees.toFixed(2)}° | Front height: ${frontHeight} mm | Rear height: ${rearHeight} mm</text>`;

svg.setAttribute("viewBox",`0 0 ${W} ${H}`);
svg.setAttribute("preserveAspectRatio","xMidYMid meet");
svg.innerHTML=d;
}

</script>

</body>
</html>
