<script>

function calculateWall() {

const length = Number(document.getElementById("wallLength").value);
const height = Number(document.getElementById("wallHeight").value);
const timber = Number(document.getElementById("timberThickness").value);
const studCount = Number(document.getElementById("studCount").value);

const doorWidth = Number(document.getElementById("doorWidth").value);
const doorHeight = Number(document.getElementById("doorHeight").value);
const doorOffset = Number(document.getElementById("doorOffset").value);
const doorPosition = document.getElementById("doorPosition").value;

const windowEnabled = document.getElementById("windowEnabled").value === "yes";
const windowWidth = Number(document.getElementById("windowWidth").value);
const windowHeight = Number(document.getElementById("windowHeight").value);
const windowSill = Number(document.getElementById("windowSill").value);
const windowOffset = Number(document.getElementById("windowOffset").value);
const windowPosition = document.getElementById("windowPosition").value;

if (!Number.isFinite(length) || !Number.isFinite(height) ||
!Number.isFinite(timber) || !Number.isFinite(studCount) ||
length <= 0 || height <= 0 || timber <= 0 ||
studCount < 2 || !Number.isInteger(studCount)) {
alert("Please enter valid wall dimensions and stud numbers.");
return;
}

if (doorWidth <= 0 || doorHeight <= 0 ||
doorWidth + timber * 2 >= length) {
alert("Please check the door dimensions.");
return;
}

if (doorHeight > height - timber) {
alert("The door height is too large for the wall.");
return;
}

if (windowEnabled &&
(windowWidth <= 0 || windowHeight <= 0 ||
windowSill < 0 ||
windowWidth + timber * 2 >= length ||
windowSill + windowHeight > height - timber)) {
alert("Please check the window dimensions.");
return;
}

const doorStart = doorPosition === "left"
? doorOffset
: length - doorOffset - (doorWidth + timber * 2);

const doorFrameWidth = doorWidth + timber * 2;
const doorClearStart = doorStart + timber;
const doorClearFinish = doorClearStart + doorWidth;
const doorFinish = doorStart + doorFrameWidth;

if (doorStart < timber || doorFinish > length - timber) {
alert("The door position is outside the usable wall area.");
return;
}

let windowStart = 0;
let windowFinish = 0;

if (windowEnabled) {
const windowFrameWidth = windowWidth + timber * 2;

windowStart = windowPosition === "left"
? windowOffset
: length - windowOffset - windowFrameWidth;

windowFinish = windowStart + windowFrameWidth;

if (windowStart < timber || windowFinish > length - timber) {
alert("The window position is outside the usable wall area.");
return;
}

if (windowSill + windowHeight > height - timber * 2) {
alert("The window does not fit within the wall.");
return;
}

if (windowStart < doorFinish && windowFinish > doorStart) {
alert("The door and window overlap. Please adjust their positions.");
return;
}
}

const fixedStuds = [
{start:0, end:timber, type:"Outer"},
{start:length-timber, end:length, type:"Outer"},
{start:doorStart, end:doorStart+timber, type:"Door"},
{start:doorClearFinish, end:doorFinish, type:"Door"}
];

if (windowEnabled) {
fixedStuds.push(
{start:windowStart, end:windowStart+timber, type:"Window"},
{start:windowStart+timber+windowWidth, end:windowFinish, type:"Window"}
);
}

fixedStuds.sort((a,b) => a.start-b.start);

for (let i=0; i<fixedStuds.length-1; i++) {
if (fixedStuds[i].end > fixedStuds[i+1].start) {
alert("The door/window positions overlap. Please adjust them.");
return;
}
}

const mainStudsNeeded = studCount - 2;
const solidIntervals = [];

for (let i=0; i<fixedStuds.length-1; i++) {
const gapStart = fixedStuds[i].end;
const gapEnd = fixedStuds[i+1].start;

if (gapEnd > gapStart) {
solidIntervals.push({start:gapStart,end:gapEnd});
}
}

const mainStuds = [];

const totalAvailableLength = solidIntervals.reduce(
(sum,interval) => sum + interval.end-interval.start, 0
);

if (mainStudsNeeded > 0 && totalAvailableLength > 0) {
let remainingStuds = mainStudsNeeded;

for (let i=0; i<solidIntervals.length; i++) {
if (remainingStuds <= 0) break;

const interval = solidIntervals[i];

let studsHere;

if (i === solidIntervals.length-1) {
studsHere = remainingStuds;
} else {
studsHere = Math.round(
mainStudsNeeded *
((interval.end-interval.start)/totalAvailableLength)
);
studsHere = Math.min(studsHere,remainingStuds);
}

if (studsHere > 0) {
const clearGap =
((interval.end-interval.start)-timber*studsHere) /
(studsHere+1);

if (clearGap <= 0) {
alert("There is not enough room for the requested main studs.");
return;
}

for (let j=0; j<studsHere; j++) {
const studStart =
interval.start + clearGap +
j*(timber+clearGap);

mainStuds.push({
start:studStart,
end:studStart+timber
});
}

remainingStuds -= studsHere;
}
}

if (remainingStuds > 0) {
alert("There is not enough space for the requested main studs.");
return;
}
}

const verticalStudLength = height-timber*2;
const cuts = [];

function addCut(name,quantity,cutLength,thickness) {
cuts.push({
name,
quantity,
length:Math.round(cutLength),
thickness:Math.round(thickness)
});
}

addCut("Bottom Rail",1,length,timber);
addCut("Top Rail",1,length,timber);
addCut("Outer End Studs",2,verticalStudLength,timber);

if (mainStuds.length > 0) {
addCut("Main Wall Studs",mainStuds.length,verticalStudLength,timber);
}

addCut("Door Vertical Frame Studs",2,verticalStudLength,timber);
addCut("Door Top Infill",1,doorWidth,timber);

if (windowEnabled) {
addCut("Window Vertical Frame Studs",2,verticalStudLength,timber);
addCut("Window Bottom Infill",1,windowWidth,timber);
addCut("Window Top Infill",1,windowWidth,timber);
}

let summaryHTML = `
<div class="result-box">
<strong>Wall Size</strong>
${length} mm × ${height} mm
</div>
<div class="result-box">
<strong>Bottom Rail</strong>
Continuous full wall length: ${length} mm
</div>
<div class="result-box">
<strong>Door</strong>
Clear opening: ${doorWidth} mm × ${doorHeight} mm
</div>
<div class="result-box">
<strong>Main Wall Studs</strong>
${mainStuds.length} additional studs
</div>
`;

if (windowEnabled) {
summaryHTML += `
<div class="result-box">
<strong>Window</strong>
Clear opening: ${windowWidth} mm × ${windowHeight} mm
</div>
`;
}

document.getElementById("summary").innerHTML = summaryHTML;

const tbody = document.querySelector("#cuttingList tbody");
tbody.innerHTML = "";

cuts.forEach(cut => {
const row = document.createElement("tr");

[cut.name,cut.quantity,cut.length,cut.thickness].forEach(value => {
const cell = document.createElement("td");
cell.textContent = value;
row.appendChild(cell);
});

tbody.appendChild(row);
});

drawDiagram(
length,height,timber,
doorStart,doorWidth,doorHeight,
windowEnabled,windowStart,windowWidth,
windowHeight,windowSill,
mainStuds,fixedStuds
);

document.getElementById("results").style.display = "block";
}


/* =====================================================
SINGLE FRONT WALL DIAGRAM
NO SECOND DIAGRAM OR FLOOR PLAN
===================================================== */

function drawDiagram(
length,height,timber,
doorStart,doorWidth,doorHeight,
windowEnabled,windowStart,windowWidth,
windowHeight,windowSill,
mainStuds,fixedStuds
) {

const svg = document.getElementById("wallDiagram");
svg.innerHTML = "";

const wallX = 120;
const wallY = 95;
const wallWidth = 960;
const wallHeight = 440;

const scale = Math.min(wallWidth/length,wallHeight/height);

const drawingWidth = length*scale;
const drawingHeight = height*scale;

const x = wallX+(wallWidth-drawingWidth)/2;
const y = wallY+(wallHeight-drawingHeight)/2;

const timberPx = timber*scale;

const mainColour = "#555";
const frameColour = "#999";
const infillColour = "#d6d6d6";
const openingColour = "#f4f4f4";

function rect(rx,ry,rw,rh,fill,stroke="#111",strokeWidth=1) {
const el = document.createElementNS("http://www.w3.org/2000/svg","rect");

el.setAttribute("x",rx);
el.setAttribute("y",ry);
el.setAttribute("width",rw);
el.setAttribute("height",rh);
el.setAttribute("fill",fill);
el.setAttribute("stroke",stroke);
el.setAttribute("stroke-width",strokeWidth);

svg.appendChild(el);
}

function line(x1,y1,x2,y2,stroke="#111",width=1,dash="") {
const el = document.createElementNS("http://www.w3.org/2000/svg","line");

el.setAttribute("x1",x1);
el.setAttribute("y1",y1);
el.setAttribute("x2",x2);
el.setAttribute("y2",y2);
el.setAttribute("stroke",stroke);
el.setAttribute("stroke-width",width);

if (dash) el.setAttribute("stroke-dasharray",dash);

svg.appendChild(el);
}

function text(tx,ty,value,size=16,anchor="middle",weight="normal") {
const el = document.createElementNS("http://www.w3.org/2000/svg","text");

el.setAttribute("x",tx);
el.setAttribute("y",ty);
el.setAttribute("font-size",size);
el.setAttribute("font-family","Arial, Helvetica, sans-serif");
el.setAttribute("text-anchor",anchor);
el.setAttribute("font-weight",weight);
el.setAttribute("fill","#111");
el.textContent = value;

svg.appendChild(el);
}

/* Wall outline */
rect(x,y,drawingWidth,drawingHeight,"#fff","#111",2);

/* Top rail */
rect(x,y,drawingWidth,timberPx,mainColour);

/* Continuous bottom rail across entire wall */
const bottomRailY = y+drawingHeight-timberPx;

rect(x,bottomRailY,drawingWidth,timberPx,mainColour);

/* Main wall studs */
mainStuds.forEach(stud => {
rect(
x+stud.start*scale,
y+timberPx,
(stud.end-stud.start)*scale,
drawingHeight-timberPx*2,
mainColour
);
});

/* Door and window vertical frame studs */
fixedStuds.forEach(stud => {
const fill = (stud.type === "Door" || stud.type === "Window")
? frameColour : mainColour;

rect(
x+stud.start*scale,
y+timberPx,
(stud.end-stud.start)*scale,
drawingHeight-timberPx*2,
fill
);
});

/* Door opening */
const doorOpeningTop = bottomRailY-doorHeight*scale;
const doorClearX = x+(doorStart+timber)*scale;

rect(
doorClearX,
doorOpeningTop,
doorWidth*scale,
doorHeight*scale,
openingColour
);

/* Door top infill - inside face, behind frame */
const doorInfillY = doorOpeningTop-timberPx;

rect(
doorClearX,
doorInfillY,
doorWidth*scale,
timberPx,
infillColour,
"#333"
);

line(
doorClearX,doorInfillY,
doorClearX+doorWidth*scale,doorInfillY,
"#666",2,"5 4"
);

/* Window */
if (windowEnabled) {

const windowBottom = bottomRailY-windowSill*scale;
const windowTop = windowBottom-windowHeight*scale;

const windowClearX = x+(windowStart+timber)*scale;

/* Window opening */
rect(
windowClearX,
windowTop,
windowWidth*scale,
windowHeight*scale,
openingColour
);

/* Bottom infill - inside */
rect(
windowClearX,
windowBottom-timberPx,
windowWidth*scale,
timberPx,
infillColour,
"#333"
);

/* Top infill - inside */
rect(
windowClearX,
windowTop-timberPx,
windowWidth*scale,
timberPx,
infillColour,
"#333"
);

line(
windowClearX,windowTop-timberPx,
windowClearX+windowWidth*scale,windowTop-timberPx,
"#666",2,"5 4"
);

line(
windowClearX,windowBottom-timberPx,
windowClearX+windowWidth*scale,windowBottom-timberPx,
"#666",2,"5 4"
);
}

/* Overall wall length dimension */
const dimensionY = y+drawingHeight+40;

line(x,dimensionY,x+drawingWidth,dimensionY,"#111",2);
line(x,dimensionY-8,x,dimensionY+8,"#111",2);
line(x+drawingWidth,dimensionY-8,x+drawingWidth,dimensionY+8,"#111",2);

text(
x+drawingWidth/2,
dimensionY+25,
`${Math.round(length)} mm`,
18,"middle","bold"
);

/* Overall wall height dimension */
const dimensionX = x-35;

line(dimensionX,y,dimensionX,y+drawingHeight,"#111",2);
line(dimensionX-8,y,dimensionX+8,y,"#111",2);
line(dimensionX-8,y+drawingHeight,dimensionX+8,y+drawingHeight,"#111",2);

const heightText = document.createElementNS("http://www.w3.org/2000/svg","text");

heightText.setAttribute("x",dimensionX-15);
heightText.setAttribute("y",y+drawingHeight/2);
heightText.setAttribute("font-size","18");
heightText.setAttribute("font-family","Arial");
heightText.setAttribute("text-anchor","middle");
heightText.setAttribute("font-weight","bold");
heightText.setAttribute(
"transform",
`rotate(-90 ${dimensionX-15} ${y+drawingHeight/2})`
);
heightText.textContent = `${Math.round(height)} mm`;

svg.appendChild(heightText);

/* Diagram title */
text(
x+drawingWidth/2,
y-25,
"FRONT WALL",
22,"middle","bold"
);

/* Door label */
text(
doorClearX+doorWidth*scale/2,
doorOpeningTop+doorHeight*scale/2+5,
`DOOR ${doorWidth} × ${doorHeight}`,
13,"middle","bold"
);

/* Window label */
if (windowEnabled) {
const windowBottom = bottomRailY-windowSill*scale;
const windowTop = windowBottom-windowHeight*scale;
const windowClearX = x+(windowStart+timber)*scale;

text(
windowClearX+windowWidth*scale/2,
windowTop+windowHeight*scale/2+5,
`WINDOW ${windowWidth} × ${windowHeight}`,
12,"middle","bold"
);
}

/* Inside infill explanation */
text(
x+drawingWidth/2,
y+drawingHeight+75,
"DOOR / WINDOW INFILLS RECESSED TO INSIDE",
15,"middle","bold"
);
}

</script>

</body>
</html>










